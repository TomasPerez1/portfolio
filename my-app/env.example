# =============================================================================
# Environment variables for my-app (Phase 7)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# ---- Existing: Nodemailer contact form ----
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your-google-app-password

# ---- Phase 7: Calendar booking ----
# Where booking notifications + contact-form replies should land.
OWNER_EMAIL=your.email@gmail.com

# Service account email (from Google Cloud Credentials page)
GOOGLE_SERVICE_ACCOUNT_EMAIL=portfolio-bot@your-project.iam.gserviceaccount.com

# Service account PRIVATE_KEY, base64-encoded (see SETUP.md Step 6)
GOOGLE_PRIVATE_KEY_B64=BASE64_ENCODED_PRIVATE_KEY_HERE

# Which calendar to read/write (gmail address for primary calendar, or a long ID for secondary)
GOOGLE_CALENDAR_ID=your.email@gmail.com

# ---- Phase 7: Schedule configuration (optional, defaults shown) ----
OWNER_TIMEZONE=America/Argentina/Buenos_Aires
WORK_HOURS_START=10
WORK_HOURS_END=18
SLOT_DURATION_MIN=30
SLOT_BUFFER_MIN=15
